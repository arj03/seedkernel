# qjs/qjs.wasm is checked in, built from qjs/csrc/ by
# qjs/build-qjs.sh, so a clone needs no wasi-sdk to build the binary.

# Built native binary (`gorun.sh build -o seedkernel[.exe] .`).
/seedkernel
/seedkernel-linux-amd64
/seedkernel.exe

# Local dev wrapper that runs the Go toolchain through WSL — machine-specific setup.
/gorun.sh

# The engine rebuild's work tree: a quickjs-ng checkout at the pinned commit plus
# cmake's output (qjs/build-qjs.sh). Disposable — the built qjs.wasm is what we keep.
/qjs/.build/

# The host blob this binary embeds as its genesis host, copied in by `npm run build:native`
# (WASM/scripts/build-host-blob.mjs).
/host.skb
