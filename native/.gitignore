# Generated host JS bundles — the shared core/ + host/ TS, bundled for //go:embed.
# Regenerate from WASM/: `npm run build:loader`.
*.gen.js

# WASM artifacts copied in by `npm run build:loader` (WASM/scripts/copy-loader-wasm.mjs):
# libsodium from the upstream npm dist, ML-DSA-65 built from the mldsa-native submodule.
# qjs/qjs.wasm is NOT ignored — it is checked in, built from qjs/csrc/ by
# qjs/build-qjs.sh, so a clone needs no wasi-sdk to build the loader.
/wasm/libsodium.wasm
/wasm/mldsa65.wasm

# Built loader binary (`gorun.sh build -o seedloader[.exe] .`).
/seedloader
/seedloader-linux-amd64
/seedloader.exe

# Local dev wrapper that runs the Go toolchain through WSL — machine-specific setup.
/gorun.sh

# The engine rebuild's work tree: a quickjs-ng checkout at the pinned commit plus
# cmake's output (qjs/build-qjs.sh). Disposable — the built qjs.wasm is what we keep.
/qjs/.build/
