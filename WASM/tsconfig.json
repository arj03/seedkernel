{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    // A subclass that means to replace a base method must say so, so renaming the base is a
    // compile error rather than a dead override: `RtcChannel.write` splits what
    // `MessageChannel.write` sends whole, and without it every large RTC write would exceed
    // the data channel's message ceiling.
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "outDir": "build",
    "rootDir": "."
  },
  "include": ["core/**/*.ts", "host/**/*.ts"],
  "exclude": []
}
