{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "removeComments": true,
    "declaration": false,
    "outDir": "build-min"
  },
  // The browser tree: the entry points a page imports, plus everything tsc reaches from them
  // (the lazily imported realm engine and module builder included). Node-only, native-only
  // and offline-authoring modules are reached by none of them, so a browser never vendors them.
  "files": [
    "core/fs.ts",
    "core/op-frame.ts",
    "host/bundle.ts",
    "host/crypto-browser.ts",
    "host/fs-memory.ts",
    "host/guest-seam.ts",
    "host/net-rtc.ts",
    "host/net-ws.ts",
    "host/peer-addr.ts",
    "host/shell-core.ts",
    "host/transport-bundle.ts",
    "host/transport-host.ts"
  ],
  "include": []
}
