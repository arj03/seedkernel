{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": false,
    // Emit only: the import graph reaches host/transport-bundle.ts, which this build
    // generates. build:host type-checks everything once it exists.
    "noCheck": true
  },
  "files": [
    "services/util.ts",
    "services/domains.ts",
    "services/net-limits.ts",
    "host/wasm-limits.ts",
    "host/bundle.ts",
    "scripts/bundle-author.ts",
    "services/op-frame.ts",
    "host/pq.ts"
  ],
  "include": []
}
