# Line endings are deliberately absent: `.gitattributes` owns them (LF in the index and in
# every checkout).
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
indent_style = tab

[*.{c,h}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
